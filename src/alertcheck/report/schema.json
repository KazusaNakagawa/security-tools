{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KazusaNakagawa/security-tools/report/schema.json",
  "title": "alertcheck report",
  "type": "object",
  "required": ["schema_version", "run", "score", "items", "findings", "coverage", "answers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "run": {
      "type": "object",
      "required": ["id", "started_at", "tool_version", "options"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "tool_version": {"type": "string"},
        "options": {"type": "object"},
        "organization": {"type": ["string", "null"]}
      }
    },
    "scope": {"type": ["object", "null"]},
    "score": {
      "type": ["object", "null"],
      "required": ["overall", "by_category", "counts", "critical", "high"],
      "properties": {
        "overall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "by_category": {
          "type": "object",
          "additionalProperties": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        },
        "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "critical": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ipa_item", "title", "category", "verdict", "findings", "missing_inputs", "rationale", "mismatch"],
        "properties": {
          "ipa_item": {"type": "string", "pattern": "^(P[1-3]|A|S|D|M)-[0-9]$"},
          "title": {"type": "string"},
          "category": {"type": "string"},
          "verdict": {"enum": ["achieved", "partial", "not_achieved", "unverified", "na"]},
          "findings": {"type": "array", "items": {"type": "string"}},
          "missing_inputs": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string"},
          "mismatch": {"type": "boolean"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "check_id", "ipa_items", "severity", "target", "title", "description", "evidence", "remediation", "references"],
        "properties": {
          "id": {"type": "string"},
          "check_id": {"type": "string"},
          "ipa_items": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "target": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "evidence": {"type": "object"},
          "remediation": {"type": "string"},
          "references": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "target", "status", "detail"],
        "properties": {
          "check_id": {"type": "string"},
          "target": {"type": "string"},
          "status": {"enum": ["executed", "skipped_no_input", "skipped_by_option", "error"]},
          "detail": {"type": "string"}
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "value"],
        "properties": {
          "question_id": {"type": "string"},
          "value": {"enum": ["done", "partial", "not_done", "na", "yes", "no", null]},
          "note": {"type": "string"},
          "evidence_path": {"type": ["string", "null"]}
        }
      }
    }
  }
}
